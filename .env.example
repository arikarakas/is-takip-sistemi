# --- Uygulama ---
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME=Sungurlar İş Takip Sistemi

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=is_takip_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend API ---
BACKEND_PORT=8000

# --- Frontend ---
# Nginx veya Vite proxy ile: /api/v1
# Doğrudan backend'e (proxy olmadan): http://localhost:8000/api/v1
VITE_API_URL=/api/v1
NGINX_PORT=8080
# DATABASE_URL POSTGRES_* değişkenlerinden otomatik oluşturulur (şifre URL-encode edilir).
# Yerel geliştirmede Docker dışında çalışıyorsanız: POSTGRES_HOST=localhost

# --- JWT Authentication ---
# En az 32 karakter; üretmek için: openssl rand -hex 32
JWT_SECRET_KEY=change_me_use_openssl_rand_hex_32_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Login brute-force koruması ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_IP_MAX_ATTEMPTS=10
LOGIN_IP_WINDOW_SECONDS=60
